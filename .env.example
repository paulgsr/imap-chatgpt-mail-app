# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
BIND_HOST=0.0.0.0
PUBLIC_BASE_URL=https://mail.example.com
# Exact host names or IP addresses accepted in HTTP Host headers.
# Add the TrueNAS IP/hostname for LAN setup and the reverse-proxy hostname.
ALLOWED_HOSTS=mail.example.com,192.168.1.20,localhost,127.0.0.1
TRUST_PROXY=true
LOG_LEVEL=info
DATA_DIR=/app/data
DATABASE_PATH=/app/data/mailapp.sqlite

# Protects the one-time /setup form before the first administrator exists.
# Generate with: openssl rand -base64 32
SETUP_TOKEN=replace-with-a-long-random-setup-token

# -----------------------------------------------------------------------------
# MCP authentication
# -----------------------------------------------------------------------------
# token: per-user personal bearer tokens for MCP Inspector/other clients.
# oauth: required for independent multi-user linking in ChatGPT.
# none: local, single-user development only; rejected when NODE_ENV=production.
AUTH_MODE=token

# Required only when AUTH_MODE=oauth. Use an established OAuth 2.1 provider.
# The provider must issue signed JWT access tokens for this MCP resource.
OAUTH_ISSUER_URL=https://YOUR_TENANT.eu.auth0.com/
OAUTH_JWKS_URL=https://YOUR_TENANT.eu.auth0.com/.well-known/jwks.json
OAUTH_AUDIENCE=https://mail.example.com
OAUTH_SCOPES=mail.read,mail.draft,mail.send
# Auto-link only occurs when the token includes email_verified=true and the
# verified email equals an existing dashboard user's email address.
OAUTH_AUTO_LINK_EMAIL=true

# -----------------------------------------------------------------------------
# Application secrets
# -----------------------------------------------------------------------------
# Signs opaque message references. Generate with: openssl rand -base64 48
ID_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Encrypts all stored IMAP/SMTP usernames and passwords with AES-256-GCM.
# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Browser dashboard sessions
SESSION_COOKIE_NAME=mailapp_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Sending safety
# -----------------------------------------------------------------------------
# Keep false until every mailbox has passed the dashboard connection test.
ALLOW_SEND=false

# -----------------------------------------------------------------------------
# Limits
# -----------------------------------------------------------------------------
MAX_MAILBOXES_PER_USER=20
MAX_PARALLEL_MAILBOX_SEARCHES=4
MAX_SEARCH_RESULTS=50
MAX_PREVIEW_SOURCE_BYTES=65536
MAX_MESSAGE_BYTES=10485760
MAX_BODY_CHARS=50000
MAX_FORWARD_ATTACHMENT_BYTES=20971520
MAX_RECIPIENTS=20
SEND_APPROVAL_TTL_SECONDS=600
