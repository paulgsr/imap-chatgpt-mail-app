{
  "name": "imap-chatgpt-mail-app",
  "version": "0.2.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "check:connections": "tsx src/cli/check-connections.ts"
  },
  "keywords": [
    "mcp",
    "chatgpt",
    "imap",
    "smtp",
    "email"
  ],
  "author": "Patrick Göser",
  "license": "MIT",
  "description": "A secure multi-user, multi-mailbox MCP/ChatGPT app with an encrypted web control centre for IMAP and SMTP.",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "imapflow": "1.4.7",
    "jose": "6.2.3",
    "mailparser": "3.9.14",
    "nodemailer": "9.0.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mailparser": "3.4.6",
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  }
}
